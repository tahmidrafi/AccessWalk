# Copy this file to .env and fill in your keys. .env is git-ignored; never commit it.
MODEL_API_KEY=            # Meta Model API key (dev.meta.ai) — SAM 3.1, Muse Spark, Voice Transcribe
META_BASE_URL=https://api.meta.ai/v1
BASETEN_API_KEY=          # Baseten key — Muse Spark Open (open-weights bonus)
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Fireworks: failover host for the open-weight agent model (verify model ID in the Fireworks dashboard)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# API (d6-api): per-job spend limit in USD (SAM estimate + agent budget), and allowed browser origins
ACCESSWALK_MAX_JOB_USD=1.0
ACCESSWALK_CORS=http://localhost:5173
