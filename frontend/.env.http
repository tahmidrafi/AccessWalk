# Vite mode file for `npm run dev:http` (no secrets): the page uses the real API
# through the dev server's proxy. The backend must be running, e.g.
#   micromamba run -n accesswalk uvicorn accesswalk.api:app --port 8010   (from backend/)
VITE_ACCESSWALK_API=http
ACCESSWALK_API_PROXY=http://127.0.0.1:8010
# Set the report behind "Try a sample route" in .env.http.local (git-ignored), e.g.
#   VITE_SAMPLE_REPORT_ID=<report_id from GET /api/reports>
