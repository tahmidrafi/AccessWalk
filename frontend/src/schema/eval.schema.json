          "readOnly": true,
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "readOnly": true,
          "title": "Recall"
        }
      },
      "required": [
        "clip",
        "precision",
        "recall"
      ],
      "title": "ClipScore",
      "type": "object"
    },
    "Counts": {
      "properties": {
        "hits": {
          "default": 0,
          "title": "Hits",
          "type": "integer"
        },
        "misses": {
          "default": 0,
          "title": "Misses",
          "type": "integer"
        },
        "matched_findings": {
          "default": 0,
          "title": "Matched Findings",
          "type": "integer"
        },
        "false_positives": {
          "default": 0,
          "title": "False Positives",
