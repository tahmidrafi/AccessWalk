{
  "$defs": {
    "CheckScore": {
      "properties": {
        "hits": {
          "default": 0,
          "title": "Hits",
          "type": "integer"
        },
        "misses": {
          "default": 0,
          "title": "Misses",
          "type": "integer"
        },
        "matched_findings": {
          "default": 0,
          "title": "Matched Findings",
          "type": "integer"
        },
        "false_positives": {
          "default": 0,
          "title": "False Positives",
          "type": "integer"
        },
        "unscored": {
          "default": 0,
          "title": "Unscored",
          "type": "integer"
        },
        "check_id": {
          "enum": [
            "sidewalk_obstruction",
            "surface_damage",
            "missing_curb_ramp",
            "sidewalk_ends",
            "steps_without_ramp",
            "missing_handrail",
            "round_doorknob",
            "narrow_passage"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "precision": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "readOnly": true,
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "readOnly": true,
          "title": "Recall"
        }
      },
      "required": [
        "check_id",
        "precision",
        "recall"
      ],
      "title": "CheckScore",
      "type": "object"
    },
    "ClipScore": {
      "properties": {
