      "type": "integer"
    },
    "systems": {
      "items": {
        "$ref": "#/$defs/SystemEval"
      },
      "title": "Systems",
      "type": "array"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
