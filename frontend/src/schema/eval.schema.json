        "system": {
          "enum": [
            "agent",
            "baseline"
          ],
          "title": "System",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "overall": {
          "$ref": "#/$defs/Counts"
        },
        "per_check": {
          "items": {
            "$ref": "#/$defs/CheckScore"
          },
          "title": "Per Check",
          "type": "array"
        },
        "per_clip": {
          "items": {
            "$ref": "#/$defs/ClipScore"
          },
          "title": "Per Clip",
          "type": "array"
        }
      },
      "required": [
        "system",
        "run_id",
        "provider",
        "model",
        "cost_usd",
        "overall",
        "per_check",
        "per_clip"
      ],
      "title": "SystemEval",
      "type": "object"
    }
